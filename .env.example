# FalkorDB Graph Database
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
GRAPH_NAME=infra

# Agent Configuration
AGENT_MODE=mock
LLM_PROVIDER=gemini
GEMINI_API_KEY=
